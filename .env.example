# .env.example
# DO NOT place real API keys in this file. Copy to .env and fill in values.
# The .env file should be added to .gitignore.

# [REQUIRED] Google Gemini API Key for System 1 and System 2 orchestration
GEMINI_API_KEY=your_gemini_api_key_here

# [REQUIRED] ngrok Auth Token for tunneling the WebSocket to Retell AI
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# [OPTIONAL] Application Settings
LOG_LEVEL=INFO
MAX_CONTEXT_TOKENS=4000